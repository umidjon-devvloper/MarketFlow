# Database (Vercel Postgres / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# UploadThing
UPLOADTHING_TOKEN=""
UPLOADTHING_SECRET=""

# Fon o'chirish — remove.bg (maxsus xizmat: mahsulotni QAYTA CHIZMAYDI,
# aynan saqlaydi; tez ~1-3s). Kalitni to'ldirsangiz avtomatik yoqiladi.
# remove.bg da ro'yxatdan o'tib kalit olinadi (bepul ~50 rasm/oy).
REMOVE_BG_API_KEY=""
# O'lcham: auto (to'liq, kredit sarflaydi) | preview (kichikroq, bepul tarif)
REMOVE_BG_SIZE="auto"
# Fon o'chirishni majburlash: "on" / "off". Bo'sh — kalit bo'lsa yoqiq.
AI_BG_REMOVAL=""

# remove.bg sozlanmagan bo'lsa fonni OpenAI (gpt-image-1) oqartirsinmi.
# Bo'sh = OPENAI_API_KEY bor bo'lsa yoqiladi. "off" — o'chiradi (sekinligi
# uchun: bitta rasm ~20-60s va rasm qayta chiziladi).
AI_BG_FALLBACK=""

# Higgsfield AI — ISHLATILMAYDI. API'da fon o'chirish modeli yo'q (faqat
# generatsiya). Bu faqat eski /ai/upscale endpointi uchun qoldirilgan.
HIGGSFIELD_API_KEY=""
HIGGSFIELD_API_URL="https://api.higgsfield.ai/v1"

# Uzum Business API
UZUM_API_URL="https://api-seller.uzum.uz/api/seller-openapi/v1"

# Encryption
ENCRYPTION_KEY="your-32-byte-encryption-key-here!!"

# AI matn/vision (kartochka maydonlarini rasmdan to'ldirish)
# Ikkalasidan bittasi yetarli — OpenAI birinchi, xato bo'lsa Gemini ishlaydi
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# UPLOADTHING_TOKEN bo'lmasa rasmlar shu manzil orqali tarqatiladi
PUBLIC_API_URL="http://localhost:4000"

# Gemini modeli (gemini-1.5-* to'xtatilgan)
GEMINI_MODEL="gemini-2.5-flash"

# 2.5 modellari javobdan oldin "o'ylash" tokenlarini sarflaydi va javob yarim
# kesilib qolishi mumkin. 0 — o'ylash o'chiq (sukut). Murakkab vazifada oshiring.
GEMINI_THINKING_BUDGET="0"

# Prisma pool (P2024 "connection pool" xatosining oldini oladi)
# DATABASE_URL oxiriga: ?connection_limit=20&pool_timeout=20&connect_timeout=30
# (Neon uyqudan uyg'onishi 10-20s olishi mumkin — connect_timeout kichik bo'lsa P1001 chiqadi)

# Har bir SQL so'rovni konsolga chiqarish (juda ko'p log beradi)
PRISMA_LOG_QUERIES=""

# ─── Qoldiq xabarnomasi (Gmail) ───────────────────────────
# 1. Gmail'da 2-bosqichli tasdiqni yoqing
# 2. https://myaccount.google.com/apppasswords → App password yarating
# 3. Quyiga qo'ying (oddiy Gmail paroli ISHLAMAYDI)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="MarketFlow"

# Telegram bildirishnoma boti (kam qoldiq xabari). @BotFather'dan token oling.
# Har tashkilot o'z chat/kanal ID sini sozlamada kiritadi.
TELEGRAM_BOT_TOKEN=""

# Xatdagi "Marketplace'larni ochish" tugmasi shu manzilga olib boradi
WEB_APP_URL="http://localhost:3000"

# Tekshiruv jadvali (cron). "off" — butunlay o'chirish
STOCK_ALERT_CRON="0 9,18 * * *"
STOCK_ALERT_TZ="Asia/Tashkent"

# Marketplace sinxronizatsiyasi (qoldiq/buyurtma keshini to'ldiradi)
# "off" — o'chirish
MARKETPLACE_SYNC_CRON="0 */3 * * *"

# Raqobatchi narxlarini o'qish jadvali. "off" — o'chirish
COMPETITOR_WATCH_CRON="0 8,20 * * *"
COMPETITOR_WATCH_TZ="Asia/Tashkent"

# WB kartochkalariga rasmni avtomatik biriktirish (WB ~30 daqiqada yaratadi).
# "off" — o'chirish.
WB_FINALIZE_CRON="*/15 * * * *"

# WB joylashdan keyingi tekshiruv: cards/upload 200 "qabul qilindi" degani,
# WB kartochkani asinxron yaratadi. Tez rad etishlarni ushlash uchun keshsiz
# xato ro'yxati necha marta va qancha oraliqda tekshiriladi.
WB_VERIFY_ATTEMPTS="2"
WB_VERIFY_GAP_MS="5000"

# Joylash navbati — tanlangan kartochkalarni marketplace'ga ketma-ket yuboradi.
# Sinxronizatsiyadan tez-tez ishlaydi: sotuvchi natijani daqiqalar ichida ko'rishi kerak.
# "off" — o'chirish
PUBLISH_QUEUE_CRON="*/2 * * * *"

# Rasm optimizatsiyasi uchun qo'shimcha host (production API domeni).
# Faqat UPLOADTHING ishlatilmaganda kerak — rasmlar o'z serveringizdan kelsa.
# NEXT_PUBLIC_IMAGE_HOST="api.marketflow.uz"
