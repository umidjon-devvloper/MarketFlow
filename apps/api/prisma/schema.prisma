// MarketFlow - Multi-user + Organization
// v4.1 - Team management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER
// ============================================

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  fullName String
  phone    String?
  avatar   String?
  isActive Boolean @default(true)

  // Har "Chiqish" da oshadi — eski refresh tokenlar shu bilan bekor qilinadi
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Yangi: tashkilotlar
  memberships Membership[]
  ownedOrgs   Organization[] @relation("OrgOwner")
  sentInvites Invitation[]   @relation("InviteSender")
  aiJobs      AiJob[]

  @@index([email])
}

// ============================================
// ORGANIZATION (tashkilot/kompaniya)
// ============================================

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // URL uchun
  logo        String?
  description String? @db.Text

  ownerId String
  owner   User   @relation("OrgOwner", fields: [ownerId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Qoldiq xabarnomasi (email) ──
  /// Qoldiq kamayganda email yuborilsinmi
  stockAlertsEnabled Boolean  @default(true)
  /// Shu sondan kam qolganda ogohlantiramiz
  lowStockThreshold  Int      @default(5)
  /// Qo'shimcha qabul qiluvchilar. Bo'sh bo'lsa — tashkilot egasining emaili
  stockAlertEmails   String[] @default([])

  // ── Telegram xabarnomasi ──
  /// Qoldiq kamayganda Telegram'ga ham yuborilsinmi
  telegramAlertsEnabled Boolean @default(false)
  /// Telegram chat/kanal ID (bot shu yerga yozadi)
  telegramChatId        String?

  // ── Stop-list (avtomatik savdodan olish) ──
  /// Qoldiq stopLimit'дан pastга tushса mahsulotni avtomatik savdodan olish
  stopListEnabled    Boolean @default(false)
  /// Shu sondan kam qolса qoldiq 0 ga tushiriladi (savdodan olinadi)
  stopLimit          Int     @default(0)

  members          Membership[]
  invitations      Invitation[]
  products         Product[]
  userMarketplaces UserMarketplace[]
  aiJobs           AiJob[]
  stockAlerts      StockAlert[]
  snapshots        MarketplaceSnapshot[]
  stockCache       MarketplaceStock[]
  syncRuns         SyncRun[]
  publishJobs      PublishJob[]
  orders           MarketplaceOrder[]
  competitorWatches CompetitorWatch[]

  @@index([ownerId])
  @@index([slug])
}

// ============================================
// MEMBERSHIP (foydalanuvchi + tashkilot + rol)
// ============================================

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role      MemberRole @default(STAFF)
  isActive  Boolean    @default(true)
  joinedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

enum MemberRole {
  OWNER // Tashkilot egasi — hammasi
  ADMIN // To'liq boshqaruv, o'chirishdan tashqari
  STAFF // Cheklangan (mahsulot yaratish, tahrirlash)
}

// ============================================
// INVITATION (xodim taklifi)
// ============================================

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("InviteSender", fields: [senderId], references: [id])

  email  String
  role   MemberRole   @default(STAFF)
  token  String       @unique
  status InviteStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  @@index([email])
  @@index([token])
  @@index([organizationId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// ============================================
// PRODUCT (endi Organization ga tegishli)
// ============================================

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Kim yaratgan (audit uchun)
  createdById String?

  title       String
  description String  @db.Text
  category    String
  brand       String?
  sku         String?
  barcode     String?

  basePrice      Decimal  @db.Decimal(15, 2)
  suggestedPrice Decimal? @db.Decimal(15, 2)
  currency       String   @default("UZS")
  stock          Int      @default(0)

  attributes Json          @default("{}")
  status     ProductStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images      ProductImage[]
  listings    Listing[]
  aiJobs      AiJob[]
  publishJobs PublishJob[]
  competitorWatches CompetitorWatch[]

  // SKU butun tizim bo'ylab emas, tashkilot ichida unikal bo'lishi kerak —
  // aks holda boshqa sotuvchi band qilgan artikulni ishlata olmaysiz
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([status])
  @@index([category])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ============================================
// PRODUCT IMAGES
// ============================================

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url         String
  originalUrl String
  fileKey     String?

  isAiProcessed Boolean      @default(false)
  aiJobId       String?
  variant       ImageVariant @default(ORIGINAL)

  order     Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variant])
}

enum ImageVariant {
  ORIGINAL
  UZUM
  OZON
  WB
  YANDEX
}

// ============================================
// LISTING
// ============================================

model Listing {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketplace Marketplace
  externalId  String?
  status      ListingStatus @default(DRAFT)

  title       String
  description String  @db.Text
  seoKeywords String? @db.Text

  price         Decimal  @db.Decimal(15, 2)
  discountPrice Decimal? @db.Decimal(15, 2)

  views   Int     @default(0)
  sales   Int     @default(0)
  revenue Decimal @default(0) @db.Decimal(15, 2)

  lastSyncedAt DateTime?
  errorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analytics AnalyticsSnapshot[]

  @@unique([productId, marketplace])
  @@index([status])
  @@index([marketplace])
}

enum Marketplace {
  UZUM
  OZON
  WB
  YANDEX
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  PAUSED
  ERROR
}

// ============================================
// MARKETPLACE CREDENTIALS (endi Org ga)
// ============================================

model UserMarketplace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    Marketplace

  apiKey    String  @db.Text
  apiSecret String? @db.Text
  shopId    String?
  shopName  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, marketplace])
  @@index([organizationId])
}

// ============================================
// AI JOBS
// ============================================

model AiJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Kunlik limit va xarajat hisobini tashkilot bo'yicha yuritamiz
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  type     AiJobType
  status   JobStatus @default(PENDING)
  provider String    @default("higgsfield")

  inputUrl  String?
  outputUrl String?

  providerJobId String?
  metadata      Json    @default("{}")

  // Xarajat kuzatuvi
  tokensUsed Int?
  costUsd    Decimal? @db.Decimal(10, 6)

  error String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([organizationId, createdAt])
}

enum AiJobType {
  BACKGROUND_REMOVE
  UPSCALE
  OUTPAINT
  GENERATE
  ADAPT_IMAGE // rasmni marketplace o'lchamiga moslashtirish
  FIELD_FILL // rasmga qarab kartochka maydonlarini to'ldirish
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// ANALYTICS
// ============================================

model AnalyticsSnapshot {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  views     Int      @default(0)
  addToCart Int      @default(0)
  sales     Int      @default(0)
  revenue   Decimal  @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())

  @@unique([listingId, date])
  @@index([listingId])
  @@index([date])
}

// ============================================
// STOCK ALERT (kam qolgan mahsulot xabarnomasi)
// ============================================

/// Bir mahsulot uchun oxirgi yuborilgan ogohlantirish.
/// Har tekshiruvda qayta email yubormaslik uchun kerak — xabar faqat
/// qoldiq birinchi marta chegaradan tushganda yoki yana kamayganda ketadi.
model StockAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  marketplace Marketplace
  /// Marketplace'dagi artikul (SKU / vendorCode / barcode)
  sku         String
  name        String?

  /// Oxirgi xabarda ko'rsatilgan qoldiq
  lastAmount    Int
  /// O'sha paytdagi chegara — sozlama o'zgarsa qayta ogohlantirish uchun
  lastThreshold Int      @default(0)
  lastSentAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, marketplace, sku])
  @@index([organizationId])
}

// ============================================
// SYNC — marketplace ma'lumotining mahalliy nusxasi
// ============================================

/// Kunlik kesim: har bir marketplace bo'yicha buyurtma, daromad va qoldiq holati.
///
/// Nega kerak: marketplace API'lari sekin va qattiq limitlangan (WB statistikasi —
/// daqiqasiga 1 ta so'rov). Sahifa har ochilganda jonli so'rov yuborish
/// mumkin emas. Cron kuniga bir necha marta shu jadvalni to'ldiradi,
/// sahifalar esa bazadan o'qiydi — darhol va limitsiz. Yon foyda: tarix
/// to'planadi, ya'ni trend va "o'tgan haftaga nisbatan" hisoblanadigan bo'ladi.
model MarketplaceSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    Marketplace

  /// Kesim sanasi (kun aniqligida) — bir kunga bitta yozuv
  date DateTime @db.Date

  /// So'nggi 30 kunlik buyurtmalar va daromad (marketplace summary'sidan)
  orders   Int     @default(0)
  revenue  Decimal @default(0) @db.Decimal(15, 2)
  currency String  @default("UZS")

  /// Qoldiq kesimi — sync paytidagi holat
  skuCount   Int @default(0)
  totalStock Int @default(0)
  lowStock   Int @default(0)
  outOfStock Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, marketplace, date])
  @@index([organizationId, date])
}

/// Joriy qoldiq — SKU bo'yicha, marketplace'dan o'qib olingan nusxa.
///
/// "Qoldiqlar" jadvali va kam qolgan mahsulot xabarnomasi shu yerdan o'qiydi.
model MarketplaceStock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    Marketplace

  sku       String
  name      String?
  amount    Int     @default(0)
  warehouse String?

  syncedAt DateTime @default(now())

  @@unique([organizationId, marketplace, sku])
  @@index([organizationId, marketplace])
}

/// Har bir sinxronizatsiya urinishining natijasi — UI'da "oxirgi yangilanish"
/// va nima uchun ishlamaganini ko'rsatish uchun.
model SyncRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    Marketplace

  status     SyncStatus
  /// Muvaffaqiyatsiz bo'lsa — sabab (marketplace javobidan)
  error      String?
  /// O'qib olingan SKU soni
  itemCount  Int        @default(0)
  durationMs Int        @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([organizationId, marketplace, startedAt])
}

enum SyncStatus {
  OK
  PARTIAL
  FAILED
}

// ============================================
// PUBLISH NAVBATI
// ============================================

/// Marketplace'ga joylash vazifasi.
///
/// Nega navbat kerak: joylash bitta HTTP so'rov emas. Ozon va WB tovarni
/// asinxron qabul qiladi — javob "qabul qilindi" deydi, natija esa bir necha
/// daqiqadan keyin ma'lum bo'ladi. WB'da ustiga rasmlar alohida qadamda,
/// kartochka sinxronlangandan keyin biriktiriladi (30 daqiqagacha).
///
/// Bunday oqimni brauzerda kutib turib bo'lmaydi: 200 ta tovar yuklamoqchi
/// bo'lgan sotuvchi sahifani ochiq tutib o'tirardi va bitta yopilgan tab
/// butun ishni to'xtatardi. Shuning uchun vazifa bazaga yoziladi, cron uni
/// bosqichma-bosqich olib boradi, sahifa esa faqat holatni ko'rsatadi.
model PublishJob {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketplace Marketplace
  status      PublishJobStatus @default(QUEUED)

  /// Marketplace tomonidagi vazifa/tovar identifikatori (Ozon task_id, WB vendorCode)
  externalId String?
  /// Sotuvchiga ko'rsatiladigan oxirgi xabar
  message    String? @db.Text
  /// Ketdi, lekin e'tibor talab qiladi (barkod generatsiya qilindi va h.k.)
  warnings   String[] @default([])

  /// Nechinchi urinish. Vaqtinchalik xatolarda qayta uriniladi, cheksiz emas
  attempts    Int       @default(0)
  /// Shu vaqtdan oldin qo'l tegizilmaydi — limitga urilganda orqaga chekinish
  nextTryAt   DateTime?

  /// Kim boshlagan (audit uchun)
  createdById String?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  /// Bir mahsulot bitta marketplace'ga bir vaqtda bir marta turadi —
  /// tugma ikki marta bosilsa ikkita kartochka yaratilib ketmasin
  @@unique([productId, marketplace])
  @@index([organizationId, status])
  @@index([status, nextTryAt])
}

enum PublishJobStatus {
  /// Navbatda kutyapti
  QUEUED
  /// Hozir yuborilyapti
  RUNNING
  /// Yuborildi, marketplace javobini kutyapmiz (Ozon import, WB sinxronizatsiyasi)
  PENDING
  /// Muvaffaqiyatli yakunlandi
  DONE
  /// Xato — sabab `message` da
  FAILED
  /// Foydalanuvchi bekor qildi
  CANCELLED
}

// ============================================
// BUYURTMALAR KESHI
// ============================================

/// Marketplace buyurtmasining mahalliy nusxasi.
///
/// Nega kesh: buyurtmalarni jonli so'rash mumkin emas. WB statistikasi
/// daqiqasiga 1 ta so'rovga ruxsat beradi, Uzum "too many requests" beradi,
/// Yandex sahifalab qaytaradi. To'rttala bozorni sahifa har ochilganda
/// so'rasak, sotuvchi 10-15 soniya kutadi va bir necha odam bir vaqtda
/// ishlasa hammasi 429 ga uriladi.
///
/// Shuning uchun cron ularni oldindan o'qib shu jadvalga yozadi, sahifa esa
/// bazadan o'qiydi — darhol, limitsiz va to'rttala bozorni bitta ro'yxatda
/// saralab bo'ladi (bu jonli so'rovlarda umuman imkonsiz edi).
model MarketplaceOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    Marketplace

  /// Marketplace tomonidagi buyurtma raqami
  externalId String
  /// Buyurtma sanasi. Marketplace bermasa — null, ro'yxat oxirida turadi
  orderedAt  DateTime?
  /// Marketplace o'z atamasi bilan ("Yangi", "Собран", "delivered"...)
  status     String?

  itemsCount Int     @default(0)
  total      Decimal @default(0) @db.Decimal(15, 2)
  currency   String  @default("UZS")

  /// Pozitsiyalar — NormalizedOrderItem[] ko'rinishida
  items Json @default("[]")

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([organizationId, marketplace, externalId])
  @@index([organizationId, orderedAt])
  @@index([organizationId, marketplace])
}

// ============================================
// RAQOBATCHI NARX KUZATUVI
// ============================================

/// Sotuvchi kuzatmoqchi bo'lgan raqobatchi tovarning ochiq havolasi.
///
/// Nega havolani sotuvchi kiritadi: "hamma raqobatchini avtomatik topish"
/// ishonchli emas — bir xil tovarni turli sotuvchi turli nom bilan qo'yadi.
/// Sotuvchi esa aynan qaysi listing bilan raqobatlashishini biladi. Biz
/// o'sha ochiq sahifani davriy o'qib, narx tarixini yuritamiz.
///
/// VALYUTA: raqobatchi narxi o'z bozori valyutasida (uzum.uz — UZS,
/// wildberries.ru — RUB). O'zining narxi bilan solishtirish faqat valyuta
/// mos kelganda qilinadi — aks holda "arzon/qimmat" degan xulosa yanglish.
model CompetitorWatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Ixtiyoriy: o'zining qaysi mahsuloti bilan solishtirish
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  marketplace Marketplace
  url         String
  /// Sotuvchi bergan nom (ro'yxatda ko'rinadi)
  label       String?

  /// Oxirgi o'qilgan narx va valyuta
  lastPrice    Decimal? @db.Decimal(15, 2)
  lastCurrency String?
  /// Sahifadan olingan nom (tekshiruv uchun)
  lastTitle    String?
  /// Oxirgi tekshiruv vaqti va natijasi
  lastCheckedAt DateTime?
  lastError     String?

  /// Narx tarixi: [{ date, price }] — oxirgi 60 nuqta saqlanadi
  history Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bir havola bir tashkilotda bir marta kuzatiladi
  @@unique([organizationId, url])
  @@index([organizationId])
  @@index([lastCheckedAt])
}
